# Local development runs without external credentials.
# Copy to .env.local when customizing; never commit credentials.

# Persistent development data directory. Empty means .data in this project.
TAMUARA_DATA_DIR=

# Optional canonical browser origin; empty uses the request Host.
TAMUARA_APP_URL=

# Explicit permission to run the local demo repository with `npm run start`.
# Leave false for deployments. Production requires Supabase mode.
TAMUARA_LOCAL_PREVIEW=false

# Set supabase only after migrations are applied and all credentials are present.
# Default is local in development; production fails closed without a backend.
TAMUARA_BACKEND=local
NEXT_PUBLIC_SUPABASE_URL=
# Current keys from Supabase Settings > API Keys. The publishable key may be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never add NEXT_PUBLIC_ to this variable or commit its value.
SUPABASE_SECRET_KEY=
# Legacy fallback for older projects; leave empty when current keys are set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# A stable 32-byte random key encoded as 64 hexadecimal characters.
# Back up securely: losing it invalidates encrypted guest/preview links.
TAMUARA_TOKEN_ENCRYPTION_KEY=

# Checkout is not connected yet. These values alone never activate payments.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
