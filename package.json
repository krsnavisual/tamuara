    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.6",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
